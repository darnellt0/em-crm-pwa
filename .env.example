CRM_POSTGRES_PORT=5434
# Keep 127.0.0.1 unless another tailnet device must reach the temporary MailHog UI.
CRM_PRIVATE_BIND_IP=127.0.0.1
DATABASE_URL="postgresql://em_app:em_secure_password@localhost:5434/em_crm"
NEXTAUTH_SECRET="generate_with_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3001"
NEXT_PUBLIC_MAIL_PREVIEW_URL="http://localhost:8025"

# Public native-app association identifiers. Leave blank until release signing
# is configured; these values are not secrets.
APPLE_TEAM_ID=""
ANDROID_APP_LINKS_SHA256_CERT_FINGERPRINTS=""

# Exact-email access control. Role lists are automatically allowlisted.
ADMIN_EMAILS="darnell.tomlinson@gmail.com,shria@elevatedmovements.com"
PARTNER_ADMIN_EMAILS=""
STAFF_EMAILS=""
READ_ONLY_EMAILS=""
ALLOWED_EMAILS=""
SEED_DARNELL_EMAIL="darnell.tomlinson@gmail.com"
SEED_SHRIA_EMAIL="shria@elevatedmovements.com"

SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Elevated Movements <no-reply@localhost>"
# For Gmail/Google Workspace, use `pnpm email:configure:gmail` instead of
# placing an account password here. The command securely requests an app password.

# Ollama on host machine (or use http://host.docker.internal:11434 if running app in Docker)
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Internal token for n8n/cron style internal routes
INTERNAL_SERVICE_TOKEN="change_me_long_random"

# Separate credential used only by EM Campaign Studio synchronization.
CAMPAIGN_STUDIO_SYNC_TOKEN="change_me_different_long_random"
CAMPAIGN_SYNC_DEFAULT_OWNER_EMAIL=""

# Separate proposal-only credential for OpenClaw. Never reuse INTERNAL_SERVICE_TOKEN.
OPENCLAW_WRITE_TOKEN="change_me_to_a_different_long_random_value"

# Local-only Phase 5 import auth. Set a real value in .env.local; do not commit secrets.
PHASE5_IMPORT_TOKEN=
